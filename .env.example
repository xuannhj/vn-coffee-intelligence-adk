# Cách 1: Dùng Google AI Studio API Key (Khuyên dùng khi chạy Local)
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Cách 2: Dùng Google Cloud Vertex AI (Khi deploy lên Cloud Run)
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_LOCATION=global

# Tùy chọn: Khóa Google Maps Platform để kích hoạt Remote Google Maps MCP Server
MAPS_API_KEY=
